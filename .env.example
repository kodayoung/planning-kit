# 이 파일을 복사해 .env 를 만들고 본인 PC 에 맞게 채우세요. (npm run setup 이 해줍니다)
# .env 는 커밋되지 않습니다. 토큰·비밀번호는 여기에만 두세요.

# ── 꼭 필요한 것 ──────────────────────────────────────────

# 프론트 개발 서버 주소. 프론트 레포에서 pnpm dev 를 돌렸을 때 뜨는 주소입니다.
FRONT_URL=http://localhost:3000

# 기획 도구가 뜰 포트. 브라우저로 여기에 접속합니다.
PORT=4000


# ── 기획안 설명을 어디서 읽을까 ────────────────────────────
#
# 둘 중 하나면 됩니다.
#
# (가) 기획안 저장소가 있는 경우 — 기획자
#      KB 의 kb 폴더(화면별 JSON)를 가리킵니다. 쉼표로 여러 곳을 적으면 합쳐 읽고,
#      같은 화면은 추출일이 최신인 것을 씁니다.
# KB_DIR=C:/내경로/기획안-kb/kb
KB_DIR=

# (나) 저장소가 없는 경우 — 개발자·QA
#      snapshots/ 에 함께 들어 있는 보관본을 씁니다. 비워두면 가장 최근 것이 자동으로 쓰입니다.
#      툴바 드롭다운에서 다른 버전으로 바꿀 수 있습니다.
SNAPSHOT=


# ── 있으면 좋은 것 ────────────────────────────────────────

# 지금 보고 있는 프론트 레포(워크트리) 경로. 툴바에 브랜치 이름을 띄웁니다.
FRONT_REPO=

# npm run gen 이 화면 주소를 읽는 지도. 기획안 저장소가 있을 때만 필요합니다.
CAPTURE_MAP=

# 목업 모드
#   off     = 전부 실제 백엔드로
#   partial = mocks/routes.yaml 에 적힌 것만 가짜로 (평소 이것)
#   all     = 모든 API 를 가짜로. 목업이 없으면 503 + 콘솔 경고
MOCK_MODE=partial


# ── 코멘트 (깃랩) ─────────────────────────────────────────
# 없으면 코멘트 기능만 꺼지고 나머지는 그대로 동작합니다.
# 토큰은 반드시 본인 계정으로 발급하세요. 남의 토큰을 쓰면 작성자가 그 사람으로 찍힙니다.
# 필요한 권한은 README 를 보세요.

GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# 코멘트 작성자가 이 계정인지 실행 시 확인합니다. 비워두면 확인하지 않습니다.
GITLAB_EXPECTED_USER=

# 스펙이 없는 화면에서 임의로 단 코멘트가 저장될 이슈 번호
GITLAB_DEFAULT_ISSUE=


# ── 공유 링크 (npm run bundle) ────────────────────────────
# 링크로 보는 사람은 토큰이 없다. 자기 깃랩 계정으로 로그인해서 코멘트를 쓴다.
# 그러려면 깃랩에 "애플리케이션"을 하나 등록하고 그 번호를 여기 적는다.
# 여기 들어가는 값에 비밀은 없다. 묶음에 그대로 실려 나가도 되는 것들이다.

GITLAB_OAUTH_CLIENT_ID=
# 배포된 링크 주소. 깃랩 앱의 Redirect URI 와 글자까지 같아야 한다.
PAGES_URL=
# 프론트 빌드 결과(dist) 경로. pnpm build 를 먼저 돌려야 한다.
FRONT_DIST=


# ── 화면 점검 (npm run check) ─────────────────────────────
# 로그인 뒤 화면을 점검하려면 본인 테스트 계정이 필요합니다.

CHECK_ID=
CHECK_PW=
